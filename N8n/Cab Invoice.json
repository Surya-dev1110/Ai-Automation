      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Cab Invoice</title>\n\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n      font-family: 'Segoe UI', sans-serif;\n    }\n\n    body {\n      background: linear-gradient(135deg, #f2f6ff, #dfe9f3);\n      padding: 40px;\n    }\n\n    .invoice-container {\n      max-width: 750px;\n      margin: auto;\n      background: #fff;\n      border-radius: 20px;\n      overflow: hidden;\n      box-shadow: 0 15px 40px rgba(0,0,0,0.12);\n    }\n\n    .top-bar {\n      background: linear-gradient(135deg, #2c3e50, #3498db);\n      color: white;\n      padding: 35px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n\n    .top-bar h1 {\n      font-size: 32px;\n      letter-spacing: 1px;\n    }\n\n    .invoice-meta {\n      text-align: right;\n      font-size: 14px;\n      line-height: 1.8;\n    }\n\n    .content {\n      padding: 35px;\n    }\n\n    .customer-box {\n      background: #f7f9fc;\n      border-radius: 15px;\n      padding: 25px;\n      margin-bottom: 30px;\n      border-left: 5px solid #3498db;\n    }\n\n    .customer-box h3 {\n      margin-bottom: 20px;\n      color: #2c3e50;\n    }\n\n    .detail-row {\n      display: flex;\n      justify-content: space-between;\n      margin-bottom: 15px;\n      padding-bottom: 10px;\n      border-bottom: 1px dashed #ddd;\n    }\n\n    .label {\n      font-weight: 600;\n      color: #555;\n    }\n\n    .value {\n      color: #222;\n    }\n\n    .fare-section {\n      background: linear-gradient(135deg, #3498db, #2ecc71);\n      color: white;\n      border-radius: 15px;\n      padding: 30px;\n      text-align: center;\n      margin-top: 20px;\n    }\n\n    .fare-section p {\n      font-size: 18px;\n      opacity: 0.9;\n      margin-bottom: 10px;\n    }\n\n    .fare-section h2 {\n      font-size: 42px;\n      letter-spacing: 1px;\n    }\n\n    .footer {\n      text-align: center;\n      padding: 25px;\n      background: #fafafa;\n      color: #777;\n      font-size: 14px;\n      border-top: 1px solid #eee;\n    }\n\n    @media(max-width: 600px) {\n      .top-bar {\n        flex-direction: column;\n        text-align: center;\n        gap: 15px;\n      }\n\n      .invoice-meta {\n        text-align: center;\n      }\n\n      .detail-row {\n        flex-direction: column;\n        gap: 5px;\n      }\n    }\n  </style>\n</head>\n\n<body>\n\n  <div class=\"invoice-container\">\n\n    <div class=\"top-bar\">\n      <div>\n        <h1>Cab Invoice</h1>\n      </div>\n\n      <div class=\"invoice-meta\">\n        <div>Invoice #: 123</div>\n        <div>Date: <span>{{ $now.format('dd-MM-yyyy') }}</span>\n</div>\n      </div>\n    </div>\n\n    <div class=\"content\">\n\n      <div class=\"customer-box\">\n        <h3>Ride Details</h3>\n\n        <div class=\"detail-row\">\n          <span class=\"label\">Customer Name</span>\n          <span class=\"value\">{{ $json.customer_name }}</span>\n        </div>\n\n        <div class=\"detail-row\">\n          <span class=\"label\">Pickup Location</span>\n          <span class=\"value\">{{ $json.from_location }}</span>\n        </div>\n\n        <div class=\"detail-row\">\n          <span class=\"label\">Drop Location</span>\n          <span class=\"value\">{{ $json.to_location }}</span>\n        </div>\n      </div>\n\n      <div class=\"fare-section\">\n        <p>Total Fare</p>\n        <h2>₹{{ $json.cost }}</h2>\n      </div>\n\n    </div>\n\n    <div class=\"footer\">\n      Thank you for riding with us 🚖\n    </div>\n\n  </div>\n  <script>\n  document.getElementById(\"invoiceDate\").innerText =\n    new Date().toLocaleDateString('en-GB');\n</script>\n\n</body>\n</html>"
